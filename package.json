{
  "name": "skilltree",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "validate": "tsx scripts/validate.ts",
    "content:import": "tsx scripts/import-bundle.ts",
    "content:ids": "tsx scripts/content-ids.ts",
    "content:bundle": "tsx scripts/export-bundle.ts",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "check": "pnpm validate && pnpm typecheck && pnpm lint && pnpm test",
    "progress:export": "tsx --env-file=.env.local scripts/progress.ts export",
    "progress:import": "tsx --env-file=.env.local scripts/progress.ts import",
    "db:smoke": "tsx --env-file=.env.local scripts/db-smoke.ts",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.0",
    "@xyflow/react": "^12.11.6",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "pg": "^8.23.0",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@10.13.1",
  "simple-git-hooks": {
    "pre-commit": "pnpm -s validate --quiet && pnpm -s test"
  }
}
