# Supabase project (Dashboard → Project Settings → API keys)
SUPABASE_PROJECT_URL=https://<project-ref>.supabase.co
# Secret key (sb_secret_…). Server-side only — never expose to the browser.
SUPABASE_SECRET_KEY=
# Postgres connection string for migrations. The direct host is IPv6-only;
# use the session pooler (Dashboard → Connect → Session pooler).
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
